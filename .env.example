# Based Clef Configuration Template
# Copy to ~/.config/based-clef/env and lock permissions: chmod 600 ~/.config/based-clef/env
# Or run `bclef init` for guided interactive setup.

CLOUDFLARE_ACCOUNT_ID=your_32_char_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_workers_ai_api_token

# Optional Model Overrides
BASED_CLEF_MODEL=@cf/cloudflare/clef-flash
BASED_CLEF_REWRITER=@cf/meta/llama-3.3-70b-instruct-fp8-fast
BASED_CLEF_ESCALATION=@cf/meta/llama-4-scout-17b-16e-instruct

# Optional Execution & Safety Tuning
BASED_CLEF_THRESHOLD=0.70
BASED_CLEF_MAX_ATTEMPTS=3
BASED_CLEF_MAX_STEPS=25
BASED_CLEF_MODE=autopilot
BASED_CLEF_VISION=true
BASED_CLEF_HIGHLIGHT=false
BASED_CLEF_STEP_DELAY=1.0
